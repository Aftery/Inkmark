# ============ 构建产物 ============
# 打包出的可执行文件（注意：build/ 下的图标资源 build/appicon.png、
# build/darwin/ 是构建必需的，要提交，只忽略 bin 目录）
build/bin/

# 前端构建产物，由 wails build 生成
frontend/dist/*
# 但保留占位文件：main.go 用 //go:embed all:frontend/dist 内嵌产物，
# 目录不存在会导致 Go 编译报 "no matching files found"
!frontend/dist/.gitkeep

# ============ 依赖 ============
node_modules/

# Go 模块与构建缓存：默认落在 ~/go/pkg/mod 与 ~/Library/Caches/go-build，
# 但在文件策略只允许写工作区的环境下（go vet/test 会报
# "open ~/Library/Caches/go-build/...: operation not permitted"）需重定向到仓内，
# 故忽略这两个本地目录。
.gocache/
.gopath/

# ============ 系统 / 编辑器 ============
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# AI 编辑器 / 本地助手的会话计划缓存（非仓库内容）
.zcode/

# ============ 日志与临时文件 ============
*.log
*.tmp

# Wails 生成的依赖变更缓存（用于判断是否要重跑 npm install）
frontend/package.json.md5

# Wails 开发期生成的 plist（构建产物，Info.plist 才是需要入库的）
build/darwin/Info.dev.plist

# Go 构建产物（go build 直接输出到项目根目录的可执行文件）
inkmark
